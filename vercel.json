{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/clicae",
      "destination": "/index.html"
    },
    {
      "source": "/clicae/:path*",
      "destination": "/:path*"
    }
  ]
}
